@model List<Service>

@{
    ViewData["Title"] = "Hizmetler Listesi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Hizmetler</h5>

        <a href="/Service/CreateService" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Hizmet Ekle
        </a>
    </div>

    <div class="card-body bg-white">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th width="120">İkon</th>
                            <th>Başlık</th>
                            <th>Açıklama</th>
                            <th width="200" class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">
                                    <i class="@item.Icon fs-3"></i>
                                    <br />
                                    <small class="text-muted">@item.Icon</small>
                                </td>

                                <td>@item.Title</td>

                                <td>@item.Description</td>

                                <td class="text-center">
                                    <button onclick="deleteService(@item.Id)"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <a href="/Service/UpdateService/@item.Id"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i> Güncelle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz hizmet eklenmemiş.</h5>

                <a href="/Service/CreateService"
                   class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle"></i> İlk Hizmeti Ekle
                </a>
            </div>
        }

    </div>
</div>

<script>
    function deleteService(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                portfolioPostDelete("/Service/DeleteService/" + id);
            }
        });
    }
</script>