@model ErrorViewModel

@{
    var code = Model.StatusCode;

    var baslik = code switch
    {
        404 => "404 - Sayfa bulunamadı",
        403 => "403 - Bu sayfaya erişim izniniz yok",
        401 => "401 - Giriş yapmanız gerekiyor",
        >= 500 => "Sunucu hatası",
        not null => $"{code} - Bir hata oluştu",
        _ => "Bir hata oluştu"
    };

    var aciklama = code switch
    {
        404 => "Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir.",
        403 => "Bu bölüm yalnızca yöneticiye açıktır.",
        401 => "Devam etmek için lütfen giriş yapın.",
        >= 500 => "İsteğiniz işlenirken bir sorun oluştu. Lütfen biraz sonra tekrar deneyin.",
        _ => "İsteğiniz işlenirken bir sorun oluştu."
    };

    ViewData["Title"] = baslik;
}

<div class="text-center py-5">
    <h1>@baslik</h1>
    <p class="lead">@aciklama</p>

    <a href="/" class="btn btn-primary mt-3">Ana sayfaya dön</a>

    @if (Model.ShowRequestId)
    {
        <p class="mt-4 text-muted">
            <strong>İstek No:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>
