                        ],
                        "headline-md": [
                                "Inter"
                        ]
                },
                "fontSize": {
                        "body-md": [
                                "16px",
                                {
                                        "lineHeight": "24px",
                                        "fontWeight": "400"
                                }
                        ],
                        "label-sm": [
                                "12px",
                                {
                                        "lineHeight": "16px",
                                        "letterSpacing": "0.05em",
                                        "fontWeight": "600"
                                }
                        ],
                        "display-lg": [
                                "72px",
                                {
                                        "lineHeight": "80px",
                                        "letterSpacing": "-0.04em",
                                        "fontWeight": "800"
                                }
                        ],
                        "body-lg": [
                                "18px",
                                {
                                        "lineHeight": "28px",
                                        "fontWeight": "400"
                                }
                        ],
                        "display-lg-mobile": [
                                "40px",
                                {
                                        "lineHeight": "48px",
                                        "letterSpacing": "-0.02em",
                                        "fontWeight": "800"
                                }
                        ],
                        "headline-md": [
                                "32px",
                                {
