@model List<ContactInfo>
@*
    footer
*@
<footer class="bg-surface-container-lowest dark:bg-surface-container-lowest border-t border-outline-variant/10 w-full py-section-padding-mobile md:py-section-padding-desktop">
    <div class="max-w-[1200px] mx-auto px-gutter flex flex-col md:flex-row justify-between items-center gap-stack-md">
        <span class="font-headline-md text-headline-md text-on-surface">KORAYHAN AVCU</span>
        <p class="font-label-sm text-label-sm text-on-surface-variant">© 2026 Korayhan Avcu Hassas bir şekilde üretilmiştir.</p>
        @foreach(var item in Model)
        {
            <div class="flex gap-stack-md">
                <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-all opacity-80 hover:opacity-100" href="@item.LinkedinUrl" target="_blank">LinkedIn</a>
                <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary transition-all opacity-80 hover:opacity-100" href="@item.GithubUrl" target="_blank">GitHub</a>
            </div>
        }
       
    </div>
</footer>
