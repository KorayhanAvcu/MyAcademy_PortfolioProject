@model Skill
@{
    ViewData["Title"] = "Yeni yetenek ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Skill Ekle</h5>
    </div>

    <div class="card-body bg-white">

        <form method="post">

            <div class="mb-3">
                <label asp-for="CategoryId" class="form-label">Proje</label>
                <select asp-for="CategoryId"
                        asp-items="@ViewBag.categories"
                        class="form-select">
                    <option value="">Proje Seçiniz</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label">Skill</label>
                <input type="text" class="form-control" asp-for="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Kaydet
                </button>
            </div>

        </form>

    </div>
</div>



