@model List<SkillVM>

@{
    ViewData["Title"] = "Yetenekler";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-center">

            <h5 class="mb-0">Yetenek Listesi</h5>

            <a href="/Skill/CreateSkill" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Yeni Yetenek Ekle
            </a>

        </div>
    </div>


    <div class="card-body bg-white">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th width="70">#</th>
                            <th>Yetenek</th>
                            <th>Kategori</th>
                            <th width="220" class="text-center">
                                İşlemler
                            </th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            count++;

                            <tr>

                                <td>@count</td>


                                <td>
                                    <span class="fw-semibold">
                                        @item.SkillName
                                    </span>
                                </td>


                                <td>
                                    <span class="badge bg-secondary">
                                        @item.CategoryName
                                    </span>
                                </td>


                                <td class="text-center">

                                    <button onclick="deleteSkill(@item.Id)"
                                            class="btn btn-danger btn-sm">

                                        <i class="bi bi-trash"></i> Sil

                                    </button>


                                    <a href="/Skill/UpdateSkill/@item.Id"
                                       class="btn btn-primary btn-sm">

                                        <i class="bi bi-pencil-square"></i> Güncelle

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <h5>Henüz yetenek bulunmuyor.</h5>

                <a href="/Skill/CreateSkill"
                   class="btn btn-primary mt-3">

                    Yetenek Oluştur

                </a>

            </div>
        }

    </div>

</div>


<script>

    function deleteSkill(id) {

        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"

        }).then((result) => {

            if (result.isConfirmed) {

                window.location.href =
                "/Skill/DeleteSkill/" + id;

            }

        });

    }

</script>