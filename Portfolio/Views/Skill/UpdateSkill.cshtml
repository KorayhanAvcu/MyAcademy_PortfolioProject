@model Skill

@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<div class="card shadow-sm border-0">

    <div class="card-header bg-white">
        <h5 class="mb-0">
            Yetenek Güncelle
        </h5>
    </div>


    <div class="card-body">

        <form method="post">


            <input type="hidden" asp-for="Id" />


            <div class="mb-3">

                <label class="form-label">
                    Yetenek Adı
                </label>

                <input asp-for="Name"
                       class="form-control" />

            </div>



            <div class="mb-3">

                <label class="form-label">
                    Kategori
                </label>


                <select asp-for="CategoryId"
                        asp-items="ViewBag.categories"
                        class="form-select">

                    <option value="">
                        Kategori Seçiniz
                    </option>

                </select>


            </div>



            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-save"></i>
                Güncelle

            </button>


            <a href="/Skill/Index"
               class="btn btn-secondary">

                Vazgeç

            </a>


        </form>

    </div>

</div>