@model Banner

@{
    ViewData["Title"] = "Banner";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    .banner-preview {
        width: 80px;
        height: 80px;
        object-fit: cover;
        cursor: pointer;
        transition: .2s;
    }

        .banner-preview:hover {
            transform: scale(1.05);
        }

    .image-modal .modal-dialog {
        width: fit-content;
        max-width: 95vw;
        margin: auto;
    }

    .image-modal .modal-content {
        width: fit-content;
        background: #fff;
    }

    .image-modal img {
        display: block;
        width: auto;
        height: auto;
        max-width: 90vw;
        max-height: 85vh;
        margin: auto;
        border-radius: 8px;
    }
</style>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Banner Bilgileri</h5>

        @if (Model == null)
        {
            <a href="/Banner/CreateBanner" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Yeni Banner Oluştur
            </a>
        }
    </div>

    <div class="card-body bg-white">

        @if (Model != null)
        {
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th width="120">Görsel</th>
                        <th>Başlık</th>
                        <th>Açıklama</th>
                        <th width="200" class="text-center">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>
                            <img src="@Model.ImageUrl"
                                 class="img-thumbnail banner-preview"
                                 data-bs-toggle="modal"
                                 data-bs-target="#imageModal" />
                        </td>

                        <td>@Model.Title</td>

                        <td>@Model.Description</td>

                        <td class="text-center">
                            <button onclick="deleteBanner(@Model.Id)"
                                    class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Sil
                            </button>

                            <a href="/Banner/UpdateBanner/@Model.Id"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-pencil-square"></i> Güncelle
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz banner bulunmuyor.</h5>

                <a href="/Banner/CreateBanner" class="btn btn-primary mt-3">
                    Banner Oluştur
                </a>
            </div>
        }

    </div>
</div>

<!-- Resim Modalı -->
<div class="modal fade image-modal" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Model?.Title</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body text-center">
                <img src="@Model?.ImageUrl" alt="@Model?.Title" />
            </div>

        </div>
    </div>
</div>

<script>
    function deleteBanner(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Banner/DeleteBanner/" + id;
            }
        });
    }
</script>