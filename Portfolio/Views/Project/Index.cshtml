@model List<Project>

@{
    ViewData["Title"] = "Projelerim";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<style>
    .project-preview {
        width: 80px;
        height: 80px;
        object-fit: cover;
        cursor: pointer;
        transition: .2s;
    }

        .project-preview:hover {
            transform: scale(1.05);
        }

    .image-modal .modal-dialog {
        width: fit-content;
        max-width: 95vw;
        margin: auto;
    }

    .image-modal .modal-content {
        width: fit-content;
    }

    .image-modal img {
        display: block;
        max-width: 90vw;
        max-height: 85vh;
        width: auto;
        height: auto;
        margin: auto;
        border-radius: 8px;
    }
</style>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Projeler</h5>

        <a href="/Project/CreateProject" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Proje Oluştur
        </a>
    </div>

    <div class="card-body bg-white">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th width="120">Görsel</th>
                            <th>Proje Adı</th>
                            <th>Açıklama</th>
                            <th>GitHub</th>
                            <th width="200" class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl"
                                         class="img-thumbnail project-preview"
                                         data-bs-toggle="modal"
                                         data-bs-target="#imageModal-@item.Id" />
                                </td>

                                <td>@item.Name</td>

                                <td>@item.Description</td>

                                <td>
                                    <a href="@item.GithubUrl"
                                       target="_blank"
                                       class="btn btn-outline-dark btn-sm">
                                        <i class="bi bi-github"></i> GitHub
                                    </a>
                                </td>

                                <td class="text-center">
                                    <button onclick="deleteProject(@item.Id)"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <a href="/Project/UpdateProject/@item.Id"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i> Güncelle
                                    </a>
                                </td>
                            </tr>

                            <!-- Resim Modalı -->
                            <div class="modal fade image-modal" id="imageModal-@item.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">

                                        <div class="modal-header">
                                            <h5 class="modal-title">@item.Name</h5>

                                            <button type="button"
                                                    class="btn-close"
                                                    data-bs-dismiss="modal">
                                            </button>
                                        </div>

                                        <div class="modal-body text-center">
                                            <img src="@item.ImageUrl" alt="@item.Name" />
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz proje eklenmemiş.</h5>

                <a href="/Project/CreateProject"
                   class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle"></i> İlk Projeyi Oluştur
                </a>
            </div>
        }

    </div>
</div>

<script>
    function deleteProject(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                portfolioPostDelete("/Project/DeleteProject/" + id);
            }
        });
    }
</script>