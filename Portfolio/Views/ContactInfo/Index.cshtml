@model ContactInfo

@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">İletişim Bilgileri</h5>

        @if (Model == null)
        {
            <a href="/ContactInfo/CreateContactInfo" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> İletişim Bilgisi Ekle
            </a>
        }
    </div>

    <div class="card-body bg-white">

        @if (Model != null)
        {
            <table class="table table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>E-Mail</th>
                        <th>Adres</th>
                        <th>LinkedIn</th>
                        <th>GitHub</th>
                        <th width="200" class="text-center">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>@Model.Email</td>

                        <td>@Model.Address</td>

                        <td>
                            <a href="@Model.LinkedinUrl"
                               target="_blank"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-linkedin"></i> Git
                            </a>
                        </td>

                        <td>
                            <a href="@Model.GithubUrl"
                               target="_blank"
                               class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-github"></i> Git
                            </a>
                        </td>

                        <td class="text-center">
                            <button onclick="deleteContactInfo(@Model.Id)"
                                    class="btn btn-danger btn-sm">
                                <i class="bi bi-trash"></i> Sil
                            </button>

                            <a href="/ContactInfo/UpdateContactInfo/@Model.Id"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-pencil-square"></i> Güncelle
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz iletişim bilgisi bulunmuyor.</h5>

                <a href="/ContactInfo/CreateContactInfo"
                   class="btn btn-primary mt-3">
                    İletişim Bilgisi Ekle
                </a>
            </div>
        }

    </div>
</div>

<script>
    function deleteContactInfo(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/ContactInfo/DeleteContactInfo/" + id;
            }
        });
    }
</script>