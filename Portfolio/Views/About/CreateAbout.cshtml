@model About

@{
    ViewData["Title"] = "Yeni Hakkımda Bilgisi Ekle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Yeni Hakkımda Bilgisi Ekle</h5>
    </div>

    <div class="card-body bg-white">

        <form method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Başlık</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripton" class="form-label">Açıklama</label>
                <textarea asp-for="Descripton" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Descripton" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ImageUrl" class="form-label">Görsel URL</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
                <div class="form-text">Dosya seçerseniz URL yerine yüklediğiniz görsel kullanılır.</div>
                <label asp-for="ImageFile" class="form-label mt-2">Görsel Dosyası (.jpg, .jpeg, .png, .webp — en fazla 2 MB)</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Kaydet
                </button>
            </div>

        </form>

    </div>
</div>
