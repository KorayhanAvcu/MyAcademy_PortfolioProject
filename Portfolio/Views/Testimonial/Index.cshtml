@model List<Testimonial>

@{
    ViewData["Title"] = "Yorumlar";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Yorumlar</h5>

        <a href="/Testimonial/CreateTestimonial" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Yorum Ekle
        </a>
    </div>

    <div class="card-body bg-white">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th width="130">Puan</th>
                            <th>Yorum</th>
                            <th>Ad Soyad</th>
                            <th>Baş Harfleri</th>
                            <th>Ünvan</th>
                            <th width="200" class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= item.Rating)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-secondary"></i>
                                        }
                                    }
                                    <span class="ms-1">(@item.Rating)</span>
                                </td>

                                <td>@item.Comment</td>

                                <td>@item.FirstName @item.LastName</td>

                                <td>
                                    <span class="badge bg-primary fs-6">
                                        @item.Initials
                                    </span>
                                </td>

                                <td>@item.Title</td>

                                <td class="text-center">
                                    <button onclick="deleteTestimonial(@item.Id)"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <a href="/Testimonial/UpdateTestimonial/@item.Id"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i> Güncelle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz yorum eklenmemiş.</h5>

                <a href="/Testimonial/CreateTestimonial"
                   class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle"></i> İlk Yorumu Ekle
                </a>
            </div>
        }

    </div>
</div>

<script>
    function deleteTestimonial(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                portfolioPostDelete("/Testimonial/DeleteTestimonial/" + id);
            }
        });
    }
</script>