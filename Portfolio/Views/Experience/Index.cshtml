@model List<Experience>

@{
    ViewData["Title"] = "Deneyim Listesi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Deneyimler</h5>

        <a href="/Experience/CreateExperience" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Deneyim Ekle
        </a>
    </div>

    <div class="card-body bg-white">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Pozisyon</th>
                            <th>Açıklama</th>
                            <th>Şirket</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th width="200" class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>

                                <td>@item.Description</td>

                                <td>@item.Company</td>

                                <td>@item.StartYear</td>

                                <td>
                                    @if (item.EndYear != null)
                                    {
                                        @item.EndYear
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Devam Ediyor</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <button onclick="deleteExperience(@item.Id)"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <a href="/Experience/UpdateExperience/@item.Id"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i> Güncelle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz deneyim eklenmemiş.</h5>

                <a href="/Experience/CreateExperience"
                   class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle"></i> İlk Deneyimi Ekle
                </a>
            </div>
        }

    </div>
</div>

<script>
    function deleteExperience(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                portfolioPostDelete("/Experience/DeleteExperience/" + id);
            }
        });
    }
</script>