@model List<Education>

@{
    ViewData["Title"] = "Eğitimler Listesi";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Eğitimler</h5>

        <a href="/Education/CreateEducation" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Eğitim Ekle
        </a>
    </div>

    <div class="card-body bg-white">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Okul Adı</th>
                            <th>Bölüm</th>
                            <th>GNO</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Açıklama</th>
                            <th width="200" class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.SchoolName</td>

                                <td>@item.Department</td>

                                <td>@item.GPA</td>

                                <td>@item.StartYear</td>

                                <td>
                                    @if (item.GraduationYear != null)
                                    {
                                        @item.GraduationYear
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Devam Ediyor</span>
                                    }
                                </td>

                                <td>@item.Description</td>

                                <td class="text-center">
                                    <button onclick="deleteEducation(@item.Id)"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <a href="/Education/UpdateEducation/@item.Id"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i> Güncelle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz eğitim bilgisi eklenmemiş.</h5>

                <a href="/Education/CreateEducation"
                   class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle"></i> İlk Eğitimi Ekle
                </a>
            </div>
        }

    </div>
</div>

<script>
    function deleteEducation(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = "/Education/DeleteEducation/" + id;
            }
        });
    }
</script>