@model UserMessage

@{
    ViewData["Title"] = "Kullanıcı Mesajı";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Kullanıcı Mesajı</h5>
    </div>

    <div class="card-body bg-white">

        

        <input type="hidden" asp-for="Id" />
        @*<div class="mb-4 form-check">
            <input asp-for="IsRead" class="form-check-input" />
            <label asp-for="IsRead" class="form-check-label">
                Okundu
            </label>
        </div>*@
        <div class="mb-3">
            <h2>İsim Soyisim</h2>
            <span>@Model.Name</span>
        </div>

        <div class="mb-3">
            <h2>E-Posta</h2>
            <p>@Model.Email</p>
        </div>

        <div class="mb-3">
            <h2>Mesaj</h2>
            <span>@Model.MessageBody</span>
        </div>

            

        <div class="d-flex justify-content-end">
            <a href="/UserMessage/Index"
               class="btn btn-sm btn-primary">
                <i class="bi bi-pencil-square"></i> Geri Dön
            </a>
        </div>

        

    </div>
</div>