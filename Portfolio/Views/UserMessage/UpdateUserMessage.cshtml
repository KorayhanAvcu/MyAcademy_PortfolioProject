@model UserMessage

@{
    ViewData["Title"] = "Kullanıcı Mesajını Güncelle";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0">Kullanıcı Mesajını Güncelle</h5>
    </div>

    <div class="card-body bg-white">

        <form method="post">

            <input type="hidden" asp-for="Id" />
            <div class="mb-4 form-check">
                <input asp-for="IsRead" class="form-check-input" />
                <label asp-for="IsRead" class="form-check-label">
                    Okundu
                </label>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">İsim Soyisim</label>
                <input asp-for="Name" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">E-Posta</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="MessageBody" class="form-label">Mesaj</label>
                <textarea asp-for="MessageBody"
                          class="form-control"
                          rows="6"
                          readonly></textarea>
            </div>

            

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-circle"></i> Güncelle
                </button>
            </div>

        </form>

    </div>
</div>