@model List<UserMessage>

@{
    ViewData["Title"] = "Kullanıcı Mesajları";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<div class="card shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h5 class="mb-0">Kullanıcı Mesajları</h5>

        <form method="get" asp-controller="UserMessage" asp-action="Index"  class="d-flex">
            <select class="form-select" name="isRead" onchange="this.form.submit()">
                @if (ViewBag.IsRead == null)
                {
                    <option value="" selected>Tümü</option>
                }
                else
                {
                    <option value="">Tümü</option>
                }

                @if (ViewBag.IsRead != null && (bool)ViewBag.IsRead)
                {
                    <option value="true" selected>Okundu</option>
                }
                else
                {
                    <option value="true">Okundu</option>
                }

                @if (ViewBag.IsRead != null && !(bool)ViewBag.IsRead)
                {
                    <option value="false" selected>Okunmadı</option>
                }
                else
                {
                    <option value="false">Okunmadı</option>
                }
            </select>
        </form>

    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th width="60">#</th>
                        <th>İsim Soyisim</th>
                        <th>E-Mail</th>
                        <th>Mesaj</th>
                        <th width="140">Durum</th>
                        <th width="180" class="text-center">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        count++;

                        <tr>
                            <td>@count</td>
                            <td>@item.Name</td>
                            <td>@item.Email</td>
                            <td>@item.MessageBody</td>
                            <td>
                                @if (item.IsRead)
                                {
                                    <span class="badge bg-success">Okundu</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Okunmadı</span>
                                }
                            </td>

                            <td class="text-center">
                                <button onclick="deleteUserMessage(@item.Id)"
                                        class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Sil
                                </button>

                                <a href="/UserMessage/UpdateUserMessage/@item.Id"
                                   class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil-square"></i> Detayı Gör
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

<script>
    function deleteUserMessage(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                portfolioPostDelete("/UserMessage/DeleteUserMessage/" + id);
            }
        });
    }
</script>