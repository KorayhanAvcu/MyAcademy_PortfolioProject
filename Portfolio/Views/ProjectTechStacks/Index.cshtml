@model List<ProjectTechStackVM>

@{
    ViewData["Title"] = "Proje Teknolojileri";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Proje Teknolojileri</h5>

        <a href="/ProjectTechStacks/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Giriş
        </a>
    </div>

    <div class="card-body bg-white">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th width="70">#</th>
                            <th>Proje Adı</th>
                            <th>Kullanılan Teknolojiler</th>
                            <th width="200" class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            count++;

                            <tr>
                                <td>@count</td>

                                <td>@item.ProjectName</td>

                                <td>
                                    @foreach (var tech in item.TechStacks.Split(','))
                                    {
                                        <span class="badge bg-secondary me-1 mb-1">@tech.Trim()</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <button onclick="deleteProjectTechStack(@item.ProjectId)"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <a href="/ProjectTechStacks/Update/@item.ProjectId"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i> Güncelle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz proje teknolojisi eklenmemiş.</h5>

                <a href="/ProjectTechStacks/Create"
                   class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle"></i> İlk Girişi Oluştur
                </a>
            </div>
        }

    </div>
</div>

<script>
    function deleteProjectTechStack(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                portfolioPostDelete("/ProjectTechStacks/Delete/" + id);
            }
        });
    }
</script>