@model List<Category>

@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
    int count = 0;
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Kategori Listesi</h5>

            <a href="/Category/CreateCategory" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Yeni Kategori Ekle
            </a>
        </div>
    </div>

    <div class="card-body bg-white">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th width="70">#</th>
                            <th>Kategori Adı</th>
                            <th width="220" class="text-center">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            count++;

                            <tr>
                                <td>@count</td>

                                <td>
                                    <span class="fw-semibold">@item.Name</span>
                                </td>

                                <td class="text-center">
                                    <button onclick="deleteCategory(@item.Id)"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>

                                    <a href="/Category/UpdateCategory/@item.Id"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-pencil-square"></i> Güncelle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>Henüz kategori bulunmuyor.</h5>

                <a href="/Category/CreateCategory"
                   class="btn btn-primary mt-3">
                    Kategori Oluştur
                </a>
            </div>
        }

    </div>
</div>

<script>
    function deleteCategory(id) {
        Swal.fire({
            title: "Silmek istediğinize emin misiniz?",
            text: "Bu işlemi geri alamazsınız!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Evet, Sil!",
            cancelButtonText: "İptal"
        }).then((result) => {
            if (result.isConfirmed) {
                portfolioPostDelete("/Category/DeleteCategory/" + id);
            }
        });
    }
</script>